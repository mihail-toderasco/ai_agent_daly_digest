# GPT Models
ACTIVE_LLM_PROVIDER=xai
XAI_API_KEY=''
XAI_MODEL=grok-4.3

# PostgreSQL
POSTGRES_HOST=[HOST]
POSTGRES_PORT=[PORT]
POSTGRES_DB_NAME=[DB_NAME]
POSTGRES_USER=[USER]
POSTGRES_PASSWORD=[PASSWORD]
DATABASE_URL=postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]

# Server
UVICORN_RELOAD=true
LOG_LEVEL=INFO # or DEBUG
